            { id: '6', mes: 'Noviembre', año: 2026, mes_num: '2026-11', concepto: 'Monotributo Corriente', tipo: 'corriente', monto: 333802.94, vencimiento: 20, pagado: false },
        ];

        renderPayments();
        updateSyncStatus('✓ Sincronizado');
    }

    // RENDERIZAR TABLA
    function renderPayments() {
        const tbody = document.getElementById('tableBody');
        tbody.innerHTML = '';

        let currentMonth = '';

        payments.forEach(payment => {
            // Encabezado de mes
            if (currentMonth !== payment.mes_num) {
                const monthHeader = document.createElement('tr');
                monthHeader.style.background = '#f0f0f0';
                monthHeader.style.fontWeight = 'bold';
                monthHeader.innerHTML = `<td colspan="5" style="padding: 12px; border-bottom: 2px solid var(--border-color);">${payment.mes} ${payment.año}</td>`;
                tbody.appendChild(monthHeader);
                currentMonth = payment.mes_num;
            }

            const row = document.createElement('tr');
            row.className = `tipo-${payment.tipo}`;
            if (payment.pagado) row.classList.add('checked');

            const fechaVencimiento = new Date(payment.año, parseInt(payment.mes_num.split('-')[1]) - 1, payment.vencimiento);
            const diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
            const fechaFormato = `${diasSemana[fechaVencimiento.getDay()]} ${payment.vencimiento} de ${payment.mes}`;

            row.innerHTML = `
                <td><input type="checkbox" data-id="${payment.id}" ${payment.pagado ? 'checked' : ''} onchange="togglePayment('${payment.id}')"></td>
                <td>${payment.mes}</td>
                <td>${payment.concepto}</td>
                <td>${fechaFormato}</td>
                <td style="text-align: right; font-weight: 600;">$${parseFloat(payment.monto).toLocaleString('es-AR', {minimumFractionDigits: 2})}</td>
            `;

            tbody.appendChild(row);
        });

        renderSummary();
    }

    // RENDERIZAR CARDS MÓVIL
    function renderMobileCards() {
        const container = document.getElementById('cardsContainer');
        container.innerHTML = '';

        let currentMonth = '';

        payments.forEach(payment => {
            if (currentMonth !== payment.mes_num) {
                const monthHeader = document.createElement('div');
                monthHeader.style.cssText = 'padding: 12px 0; font-weight: bold; color: var(--primary-dark); margin-top: 12px; border-bottom: 2px solid var(--border-color);';
                monthHeader.innerHTML = `${payment.mes} ${payment.año}`;
                container.appendChild(monthHeader);
                currentMonth = payment.mes_num;
            }

            const card = document.createElement('div');
            card.className = `payment-card tipo-${payment.tipo} ${payment.pagado ? 'checked' : ''}`;

            const fechaVencimiento = new Date(payment.año, parseInt(payment.mes_num.split('-')[1]) - 1, payment.vencimiento);
            const diasSemana = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
            const fechaFormato = `${diasSemana[fechaVencimiento.getDay()]} ${payment.vencimiento}`;

            card.innerHTML = `
                <div class="card-header">
                    <div>
                        <div class="card-fecha">${payment.concepto}</div>
                        <div class="card-monto">$${parseFloat(payment.monto).toLocaleString('es-AR', {minimumFractionDigits: 2})}</div>
                    </div>
                    <input type="checkbox" data-id="${payment.id}" ${payment.pagado ? 'checked' : ''} onchange="togglePayment('${payment.id}')" style="width: 24px; height: 24px;">
                </div>
                <div class="card-vencimiento">Vence: ${fechaFormato}</div>
            `;

            container.appendChild(card);
        });

        renderSummary();
    }

    // RESUMEN
    function renderSummary() {
        const totalPlanes = payments.filter(p => p.tipo !== 'corriente' && !p.pagado).reduce((sum, p) => sum + p.monto, 0);
        const totalCorriente = payments.filter(p => p.tipo === 'corriente').reduce((sum, p) => sum + p.monto, 0);
        const totalPagados = payments.filter(p => p.pagado).length;

        const summaryHTML = `
            <div class="summary-card">
                <h3>💰 Planes de Pago</h3>
                <div class="amount">$${totalPlanes.toLocaleString('es-AR', {minimumFractionDigits: 2})}</div>
                <div class="detail">Pendiente de planes</div>
            </div>
            <div class="summary-card corriente">
                <h3>📅 Monotributo Mensual</h3>
                <div class="amount">$${totalCorriente.toLocaleString('es-AR', {minimumFractionDigits: 2})}</div>
                <div class="detail">21 meses</div>
            </div>
            <div class="summary-card">
                <h3>📊 Pagados</h3>
                <div class="amount">${totalPagados}/${payments.length}</div>
                <div class="detail">De planes de pago</div>
            </div>
        `;

        document.getElementById('summaryDesktop').innerHTML = summaryHTML;
        document.getElementById('summaryMobile').innerHTML = summaryHTML;
    }

    // TOGGLE PAGO
    function togglePayment(id) {
        const payment = payments.find(p => p.id === id);
        if (payment) {
            payment.pagado = !payment.pagado;
            saveToDB(payment);
            renderPayments();
            renderMobileCards();
        }
    }

    // GUARDAR EN GOOGLE SHEET
    function saveToDB(payment) {
        updateSyncStatus('Guardando...');
        // Aquí guardarías en Google Sheets
        // Por ahora solo actualiza localStorage
        localStorage.setItem(`payment_${payment.id}`, JSON.stringify(payment));
        setTimeout(() => updateSyncStatus('✓ Sincronizado'), 500);
    }

    // FILTRAR POR MES - ESCRITORIO
    function filterPaymentsDesktop() {
        const filter = document.getElementById('mesFilterDesktop').value;
        const rows = document.querySelectorAll('#tableBody tr');
        
        rows.forEach(row => {
            if (!filter || row.textContent.includes(filter) || row.className.includes('tipo-')) {
                row.style.display = row.className.includes('tipo-') ? 
                    (filter && !row.textContent.includes(filter) ? 'none' : '') : '';
            }
        });
    }

    // FILTRAR POR MES - MÓVIL
    function filterPaymentsMobile() {
        const filter = document.getElementById('mesFilterMobile').value;
        const cards = document.querySelectorAll('.payment-card');
        
        cards.forEach(card => {
            card.style.display = !filter || card.textContent.includes(filter) ? '' : 'none';
        });
    }

    // LIMPIAR MARCAS
    function resetearPagosDesktop() {
        if (confirm('¿Estás seguro de que quieres limpiar todas las marcas?')) {
            payments.forEach(p => {
                p.pagado = false;
                saveToDB(p);
            });
            renderPayments();
        }
    }

    function resetearPagosMobile() {
        resetearPagosDesktop();
        renderMobileCards();
    }

    // AGREGAR A GOOGLE CALENDAR
    function addAllToCalendar() {
        const calendarUrl = 'https://calendar.google.com/calendar/u/0/r/eventedit';
        
        payments.forEach((payment, index) => {
            setTimeout(() => {
                const fechaVencimiento = new Date(payment.año, parseInt(payment.mes_num.split('-')[1]) - 1, payment.vencimiento);
                const fecha = fechaVencimiento.toISOString().split('T')[0];
                
                const event = {
                    title: `${payment.concepto} - $${parseFloat(payment.monto).toLocaleString('es-AR')}`,
                    dates: `${fecha}/${fecha}`,
                    details: `Vencimiento: ${payment.vencimiento} de ${payment.mes}\nContadora: Candela Larragneguy`,
                };

                window.open(`https://calendar.google.com/calendar/u/0/r/eventedit?text=${encodeURIComponent(event.title)}&dates=${event.dates}`);
            }, index * 500);
        });

        alert('✓ Se abrirán los eventos en tu Google Calendar. Guarda cada uno.');
    }

    // SYNC STATUS
    function updateSyncStatus(text) {
        document.getElementById('syncStatus').textContent = text;
        document.getElementById('syncStatusMobile').textContent = text;
    }

    // LOGOUT
    function logout() {
        if (confirm('¿Cerrar sesión?')) {
            localStorage.clear();
            location.reload();
        }
    }

    // INICIALIZA AL CARGAR
    window.onload = function() {
        const userEmail = localStorage.getItem('userEmail');
        if (userEmail) {
            document.getElementById('loginScreen').classList.add('hidden');
            document.getElementById('mainContainer').classList.remove('hidden');
            loadPayments();
        }
    };
</script>

</body>
</html>
