            margin-bottom: 4px;
        }

        .footer .subtitle-footer {
            font-weight: 600;
            color: var(--accent-gold);
            margin-bottom: 8px;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            .desktop-version {
                display: none !important;
            }

            .controls {
