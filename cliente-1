        }).then(() => {
            console.log('Google API initialized');
        });
    }

    // OBTENER ACCESS TOKEN (necesario para Sheets y Calendar)
    function getAccessToken() {
        return new Promise((resolve, reject) => {
            const jwtToken = localStorage.getItem('jwtToken');
            if (jwtToken) {
                // Aquí necesitarías un servidor backend para intercambiar JWT por Access Token
                // Por ahora, usamos el JWT directamente en algunas APIs
                resolve(jwtToken);
            } else {
                reject('No token found');
            }
        });
    }

    // CARGAR PAGOS DESDE GOOGLE SHEET
    function loadPayments() {
        updateSyncStatus('Sincronizando...');

        const jwtToken = localStorage.getItem('jwtToken');
        const url = `https://sheets.googleapis.com/v4/spreadsheets/${SHEET_ID}/values/${SHEET_NAME}?key=AIzaSyDummy`;

        // Para una solución real, necesitarías un servidor backend que maneje OAuth
        // Por ahora, cargamos datos de ejemplo
