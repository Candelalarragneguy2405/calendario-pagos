        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-dark: #1B4D7D;
            --primary-light: #2A6FB3;
            --secondary: #4A5568;
            --accent-gold: #D4A574;
            --accent-green: #20A39E;
            --light-bg: #F5F7FA;
            --white: #FFFFFF;
            --border-color: #E0E4E8;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #F5F7FA 0%, #E8ECEF 100%);
            min-height: 100vh;
            padding: 20px;
        }

        /* PANTALLA DE LOGIN */
        .login-screen {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #F5F7FA 0%, #E8ECEF 100%);
            z-index: 9999;
        }

        .login-screen.hidden {
            display: none !important;
        }

        .login-card {
            background: var(--white);
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(27, 77, 125, 0.3);
            padding: 40px 30px;
            max-width: 500px;
            width: 100%;
            text-align: center;
            border-top: 5px solid var(--accent-gold);
        }

        .login-card .firma-profesional {
            font-size: 22px;
            color: var(--primary-dark);
            font-weight: 700;
            margin-bottom: 5px;
            letter-spacing: 0.3px;
            line-height: 1.3;
        }

        .login-card .titulo-profesional {
            font-size: 14px;
            color: var(--secondary);
            font-weight: 600;
            margin-bottom: 30px;
            letter-spacing: 0.2px;
        }

        #g_id_onload {
            display: flex !important;
            justify-content: center;
        }

        /* PANTALLA PRINCIPAL */
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .desktop-version,
        .mobile-version {
            background: var(--white);
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        /* HEADER */
        .header {
            background: linear-gradient(135deg, var(--primary-dark) 0%, var(--primary-light) 100%);
            color: var(--white);
            padding: 20px;
            text-align: center;
            border-bottom: 3px solid var(--accent-gold);
        }

        .header h1 {
            font-size: 24px;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .header p {
            font-size: 13px;
            opacity: 0.95;
            margin-bottom: 3px;
        }

        .header p strong {
            font-weight: 700;
            display: block;
            margin-bottom: 2px;
        }

        .header .subtitle {
            font-size: 11px;
            opacity: 0.85;
            color: var(--accent-gold);
            font-weight: 600;
        }

        /* SYNC STATUS */
        .sync-status {
            padding: 10px 20px;
            background: var(--light-bg);
            font-size: 11px;
            color: var(--secondary);
            text-align: right;
            border-bottom: 1px solid var(--border-color);
        }

        .sync-status.syncing {
            color: var(--accent-green);
        }

        .sync-status.error {
            color: #dc2626;
        }

        /* CONTROLES */
        .controls {
            padding: 16px;
            background: var(--light-bg);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .controls label {
            font-weight: 600;
            color: var(--secondary);
            font-size: 13px;
        }

        .controls select {
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            font-size: 13px;
            background: var(--white);
            cursor: pointer;
        }

        .controls button,
        .controls a {
            padding: 10px 14px;
            border: none;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .controls button {
            background: var(--primary-dark);
            color: var(--white);
        }

        .controls button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(27, 77, 125, 0.15);
        }

        .print-btn {
            background: var(--secondary) !important;
        }

        .back-btn {
