    }

    // DATOS DE EJEMPLO (mientras configuras el backend)
    function loadDemoData() {
        payments = [
            { id: '1', mes: 'Octubre', año: 2026, mes_num: '2026-10', concepto: 'Plan ARCA', tipo: 'arca', monto: 71695.65, vencimiento: 16, pagado: false },
