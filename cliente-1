        .summary-card .amount {
            font-size: 20px;
            color: var(--primary-dark);
            font-weight: 700;
        }

        .summary-card .detail {
            font-size: 11px;
            color: var(--secondary);
            margin-top: 4px;
        }

        /* FOOTER */
