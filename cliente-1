            }

            .mobile-version .header h1 {
                font-size: 18px;
                margin-bottom: 6px;
            }

            .mobile-version .header p {
                font-size: 12px;
                margin-bottom: 3px;
            }
        }

        @media (min-width: 769px) {
            .mobile-version {
                display: none !important;
            }
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: var(--secondary);
        }

        .loading::after {
            content: '';
            display: inline-block;
            width: 20px;
            height: 20px;
