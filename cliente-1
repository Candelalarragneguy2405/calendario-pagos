<script>
    // CONFIGURACIÓN
    const CLIENT_ID = '245604969675-k53tl31tugp76q72vj3k3ckio8qcn9ej.apps.googleusercontent.com';
    const SHEET_ID = '1Dluwah35f607c8cR-SA6eLG4XGpc04_x3lnsmTNbKqg';
